{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, max-stale=43200" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/staff-apply/list", "dest": "/api/staff-apply-list.js" },
    { "src": "/api/staff-apply/update/(.*)", "dest": "/api/staff-apply-update.js" },
    { "src": "/api/test-result", "dest": "/api/test-result.js" },
    { "src": "/api/staff-apply", "dest": "/api/staff-apply.js" }
  ]
}
